&Lattice
Lx            = 4   ! Number of unit lattices on the x direction
Ly            = 4   ! Number of unit lattices on the x direction
/

&Simulation
beta          = 1       ! Inverse temperature
n_bins        = 10        ! Number of bins 
mc_sweeps     = 1     ! Number of measurement cycles per bin
/

&Hamiltonian
alpha         = 1.0
/

&Replica_Exchange
n_exchange_steps      = 5   ! Number of total exchanges 
n_exchange_frequency  = 100  ! The frequency in units of sweeps at which the exchange moves are carried out
n_replica_walkers     = 5  ! Number of replica configurations
/

&Analysis
n_skip        = 5   ! Skip first n_skip bins
n_rebin       = 1    ! Takes the average of n_rebin bins
/
